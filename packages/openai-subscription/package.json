{
  "name": "@repo/openai-subscription",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Доступ к моделям OpenAI через подписку ChatGPT: вход, хранение и автообновление токенов, модель для AI SDK.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "majordomo-openai": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run --dir src"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.19",
    "@fieldwork-ai/codex-transport": "0.1.7",
    "@spotsccc/error-as-value": "^0.14.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  }
}
