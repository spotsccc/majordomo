{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Consumed as source by Next.js and Vitest: resolve `next/*` the way a bundler does.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
