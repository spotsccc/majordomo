          "name": "transactions_type_check",
          "value": "\"finance\".\"transactions\".\"type\" in ('income', 'expense', 'transfer', 'adjustment')"
        },
        "transactions_sides_check": {
          "name": "transactions_sides_check",
          "value": "num_nulls(\"finance\".\"transactions\".\"from_wallet_id\", \"finance\".\"transactions\".\"from_currency\", \"finance\".\"transactions\".\"from_amount\") in (0, 3)\n        and num_nulls(\"finance\".\"transactions\".\"to_wallet_id\", \"finance\".\"transactions\".\"to_currency\", \"finance\".\"transactions\".\"to_amount\") in (0, 3)\n        and case \"finance\".\"transactions\".\"type\"\n          when 'income' then \"finance\".\"transactions\".\"from_wallet_id\" is null and \"finance\".\"transactions\".\"to_wallet_id\" is not null\n          when 'expense' then \"finance\".\"transactions\".\"from_wallet_id\" is not null and \"finance\".\"transactions\".\"to_wallet_id\" is null\n          when 'transfer' then \"finance\".\"transactions\".\"from_wallet_id\" is not null and \"finance\".\"transactions\".\"to_wallet_id\" is not null\n          when 'adjustment' then (\"finance\".\"transactions\".\"from_wallet_id\" is null) <> (\"finance\".\"transactions\".\"to_wallet_id\" is null) and \"finance\".\"transactions\".\"fee_amount\" is null\n          else false\n        end"
        },
        "transactions_same_balance_check": {
          "name": "transactions_same_balance_check",
          "value": "not (\"finance\".\"transactions\".\"from_wallet_id\" = \"finance\".\"transactions\".\"to_wallet_id\" and \"finance\".\"transactions\".\"from_currency\" = \"finance\".\"transactions\".\"to_currency\")"
        },
        "transactions_same_currency_amount_check": {
          "name": "transactions_same_currency_amount_check",
          "value": "\"finance\".\"transactions\".\"from_currency\" <> \"finance\".\"transactions\".\"to_currency\" or \"finance\".\"transactions\".\"from_amount\" = \"finance\".\"transactions\".\"to_amount\""
        },
        "transactions_fee_check": {
          "name": "transactions_fee_check",
          "value": "(\"finance\".\"transactions\".\"fee_currency\" is null) = (\"finance\".\"transactions\".\"fee_amount\" is null)\n        and (\"finance\".\"transactions\".\"fee_currency\" is null or \"finance\".\"transactions\".\"from_wallet_id\" is not null)"
        },
        "transactions_category_check": {
          "name": "transactions_category_check",
          "value": "(\"finance\".\"transactions\".\"category_id\" is not null) = (\"finance\".\"transactions\".\"type\" = 'expense')"
        },
