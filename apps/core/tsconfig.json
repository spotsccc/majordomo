{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "playwright.config.ts",
    "test-database.test-utils.ts",
    "vitest.config.ts",
    "vitest.global-setup.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
