# Postgres. Locally: the Docker database from compose.yaml (pnpm db:up).
# On Vercel the Neon integration sets both, e.g.
# postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://majordomo:majordomo@localhost:5432/majordomo
DATABASE_URL_UNPOOLED=postgresql://majordomo:majordomo@localhost:5432/majordomo

# All variables without a default are required: the server does not build or start
# without them (src/lib/config.ts).

# Encrypts tokens in the database. On Vercel the production key is set for Production
# only; Preview gets its own key. Locally: your own key, never the production one.
# Generate: openssl rand -base64 32
# Several comma-separated keys: the first encrypts, all decrypt (rotation).
SECRETS_ENCRYPTION_KEYS=

# Owner's token: clients send it as Authorization: Bearer ..., the browser logs in with it on /login.
# At least 32 chars: openssl rand -base64 32. Changing it signs out every browser.
MAJORDOMO_API_TOKEN=

# Vercel sends it to cron routes as Authorization: Bearer ...
CRON_SECRET=

# Model for the agent (see OPENAI_SUBSCRIPTION_MODEL_ID_LIST). Optional, defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna

# Telegram bot. Optional: without the token, the secret and the owner id the bot is off
# and /api/telegram/webhook answers 500. Production sets the production bot; locally use
# your own dev bot from @BotFather, never the production token.
TELEGRAM_BOT_TOKEN=
# Telegram sends it with every webhook (X-Telegram-Bot-Api-Secret-Token). Generate:
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# The owner's numeric Telegram user id: the bot answers nobody else.
TELEGRAM_OWNER_ID=
# The bot's username without @. Optional: without it the bot asks Telegram on start.
TELEGRAM_BOT_USERNAME=

# xAI key for transcribing the owner's Telegram voice messages (console.x.ai).
# Optional: without it the bot answers voice messages that transcription is not set up.
XAI_API_KEY=

# CoinGecko Demo API key (x-cg-demo-api-key) for the daily exchange rates. Optional:
# without it the free keyless limit applies.
COINGECKO_API_KEY=

# The owner's IANA time zone: "yesterday" and month boundaries are counted in it.
# Optional, defaults to UTC.
OWNER_TIME_ZONE=America/Argentina/Buenos_Aires

# Preview deployments migrate their database only when Neon preview branching is on.
# MIGRATE_PREVIEW_DATABASES=true
