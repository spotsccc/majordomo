# Postgres (Neon). The Vercel–Neon integration sets both automatically.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Encrypts tokens in the database. Production only! Generate: openssl rand -base64 32
# Several comma-separated keys: the first encrypts, all decrypt (rotation).
SECRETS_ENCRYPTION_KEYS=

# Owner's API token for the clients (Authorization: Bearer ...). At least 32 chars: openssl rand -base64 32
MAJORDOMO_API_TOKEN=

# Vercel sends it to cron routes as Authorization: Bearer ...
CRON_SECRET=

# Model for the agent (see OPENAI_SUBSCRIPTION_MODEL_ID_LIST).
OPENAI_MODEL=gpt-5.6-luna

# Preview deployments migrate their database only when Neon preview branching is on.
# MIGRATE_PREVIEW_DATABASES=true
