{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @repo/db migrate && pnpm turbo run build --filter=@repo/core",
  "crons": [
    {
      "path": "/api/cron/openai-refresh",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/finance-rates",
      "schedule": "37 4 * * *"
    },
    {
      "path": "/api/cron/memory",
      "schedule": "7 10 * * *"
    }
  ]
}
